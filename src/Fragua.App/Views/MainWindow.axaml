<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fragua.App.ViewModels"
        xmlns:models="using:Fragua.App.Models"
        xmlns:conv="using:Fragua.App.Converters"
        xmlns:convData="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="620"
        x:Class="Fragua.App.Views.MainWindow"
        x:DataType="vm:ConvertViewModel"
        Icon="avares://Fragua.App/Assets/Icons/fragua.ico"
        Title="Fragua"
        Width="960" Height="640" MinWidth="720" MinHeight="520"
        DragDrop.AllowDrop="True">

  <Window.Resources>
    <conv:ByteSizeConverter x:Key="ByteSize" />
    <conv:PercentConverter x:Key="Percent" />
    <conv:BoolToBrushConverter x:Key="StatusBrush"
                               TrueBrush="{StaticResource FraguaErrorBrush}"
                               FalseBrush="{StaticResource FraguaTextMutedBrush}" />
    <conv:BoolToBrushConverter x:Key="NavIconBrush"
                               TrueBrush="{StaticResource FraguaEmberBrush}"
                               FalseBrush="{StaticResource FraguaTextMutedBrush}" />
    <conv:BatchStatusConverter x:Key="BatchStatus" />
  </Window.Resources>

  <Grid ColumnDefinitions="220,*" Background="{DynamicResource FraguaCanvasBrush}">

    <!-- Barra lateral -->
    <Border Grid.Column="0" Background="{DynamicResource FraguaPanelBrush}"
            BorderBrush="{DynamicResource FraguaLineBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="16,20">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="6,0,0,30">
          <Image Source="avares://Fragua.App/Assets/Icons/fragua-32.png" Width="32" Height="32" />
          <TextBlock Text="Fragua" FontSize="{DynamicResource Text2xl}" FontWeight="Bold"
                     VerticalAlignment="Center" LetterSpacing="-0.2" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="2">
          <Button Classes.active="{Binding IsConvertTab}" Classes="nav"
                  Command="{Binding GoToTabCommand}" CommandParameter="{x:Static vm:AppTab.Convert}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Canvas Width="16" Height="16" VerticalAlignment="Center">
                <Path Data="M2 5h9M8 2l3 3-3 3M14 11H5M8 14l-3-3 3-3"
                      Stroke="{Binding IsConvertTab, Converter={StaticResource NavIconBrush}}" StrokeThickness="1.6"
                      StrokeLineCap="Round" StrokeJoin="Round" />
              </Canvas>
              <TextBlock Text="Convertir" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes.active="{Binding IsBatchTab}" Classes="nav"
                  Command="{Binding GoToTabCommand}" CommandParameter="{x:Static vm:AppTab.Batch}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Canvas Width="16" Height="16" VerticalAlignment="Center">
                <Rectangle Canvas.Left="2" Canvas.Top="2" Width="12" Height="2" RadiusX="1" RadiusY="1"
                           Fill="{DynamicResource FraguaTextMutedBrush}" />
                <Rectangle Canvas.Left="2" Canvas.Top="7" Width="12" Height="2" RadiusX="1" RadiusY="1"
                           Fill="{DynamicResource FraguaTextMutedBrush}" Opacity="0.7" />
                <Rectangle Canvas.Left="2" Canvas.Top="12" Width="8" Height="2" RadiusX="1" RadiusY="1"
                           Fill="{DynamicResource FraguaTextMutedBrush}" Opacity="0.45" />
              </Canvas>
              <TextBlock Text="Lotes" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes.active="{Binding IsIconsTab}" Classes="nav"
                  Command="{Binding GoToTabCommand}" CommandParameter="{x:Static vm:AppTab.Icons}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Canvas Width="16" Height="16" VerticalAlignment="Center">
                <Rectangle Canvas.Left="1" Canvas.Top="1" Width="10" Height="10" RadiusX="2" RadiusY="2"
                           Stroke="{DynamicResource FraguaTextMutedBrush}" StrokeThickness="1.4" />
                <Rectangle Canvas.Left="5" Canvas.Top="5" Width="10" Height="10" RadiusX="2" RadiusY="2"
                           Fill="{DynamicResource FraguaPanelBrush}" Stroke="{DynamicResource FraguaTextMutedBrush}"
                           StrokeThickness="1.4" />
              </Canvas>
              <TextBlock Text="Iconos" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes.active="{Binding IsMetadataTab}" Classes="nav"
                  Command="{Binding GoToTabCommand}" CommandParameter="{x:Static vm:AppTab.Metadata}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Canvas Width="16" Height="16" VerticalAlignment="Center">
                <Path Data="M2 2h7l5 5-7 7-5-5z" Stroke="{DynamicResource FraguaTextMutedBrush}"
                      StrokeThickness="1.4" StrokeJoin="Round" />
                <Ellipse Canvas.Left="4.3" Canvas.Top="4.3" Width="1.8" Height="1.8"
                         Fill="{DynamicResource FraguaTextMutedBrush}" />
              </Canvas>
              <TextBlock Text="Metadatos" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes.active="{Binding IsPaletteTab}" Classes="nav"
                  Command="{Binding GoToTabCommand}" CommandParameter="{x:Static vm:AppTab.Palette}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Canvas Width="16" Height="16" VerticalAlignment="Center">
                <Ellipse Canvas.Left="1" Canvas.Top="3" Width="7" Height="7"
                         Fill="{DynamicResource FraguaTextMutedBrush}" Opacity="0.9" />
                <Ellipse Canvas.Left="8" Canvas.Top="3" Width="7" Height="7"
                         Fill="{DynamicResource FraguaTextMutedBrush}" Opacity="0.55" />
                <Ellipse Canvas.Left="4.5" Canvas.Top="8.5" Width="7" Height="7"
                         Fill="{DynamicResource FraguaTextMutedBrush}" Opacity="0.3" />
              </Canvas>
              <TextBlock Text="Paleta" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes.active="{Binding IsCollageTab}" Classes="nav"
                  Command="{Binding GoToTabCommand}" CommandParameter="{x:Static vm:AppTab.Collage}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Canvas Width="16" Height="16" VerticalAlignment="Center">
                <Rectangle Canvas.Left="1" Canvas.Top="1" Width="6" Height="6"
                           Fill="{DynamicResource FraguaTextMutedBrush}" Opacity="0.9" />
                <Rectangle Canvas.Left="9" Canvas.Top="1" Width="6" Height="6"
                           Fill="{DynamicResource FraguaTextMutedBrush}" Opacity="0.55" />
                <Rectangle Canvas.Left="1" Canvas.Top="9" Width="6" Height="6"
                           Fill="{DynamicResource FraguaTextMutedBrush}" Opacity="0.55" />
                <Rectangle Canvas.Left="9" Canvas.Top="9" Width="6" Height="6"
                           Fill="{DynamicResource FraguaTextMutedBrush}" Opacity="0.3" />
              </Canvas>
              <TextBlock Text="Collage" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes.active="{Binding IsHistoryTab}" Classes="nav"
                  Command="{Binding GoToTabCommand}" CommandParameter="{x:Static vm:AppTab.History}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Canvas Width="16" Height="16" VerticalAlignment="Center">
                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="14" Height="14"
                         Stroke="{DynamicResource FraguaTextMutedBrush}" StrokeThickness="1.4" />
                <Path Data="M8 4.5v3.8l2.6 2.1" Stroke="{DynamicResource FraguaTextMutedBrush}"
                      StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" />
              </Canvas>
              <TextBlock Text="Historial" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes.active="{Binding IsAboutTab}" Classes="nav"
                  Command="{Binding GoToTabCommand}" CommandParameter="{x:Static vm:AppTab.About}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Canvas Width="16" Height="16" VerticalAlignment="Center">
                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="14" Height="14"
                         Stroke="{DynamicResource FraguaTextMutedBrush}" StrokeThickness="1.4" />
                <Line StartPoint="8,7" EndPoint="8,11.5" Stroke="{DynamicResource FraguaTextMutedBrush}" StrokeThickness="1.4" StrokeLineCap="Round" />
                <Ellipse Canvas.Left="7.3" Canvas.Top="4.3" Width="1.4" Height="1.4" Fill="{DynamicResource FraguaTextMutedBrush}" />
              </Canvas>
              <TextBlock Text="Acerca de" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="v0.13.0" Classes="muted" FontSize="{DynamicResource TextXs}"
                   Margin="10,0,0,0" />
      </Grid>
    </Border>

    <!-- Zona de trabajo -->
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
     <Grid>

      <!-- Pestana Convertir -->
      <StackPanel Margin="32,28" Spacing="20" HorizontalAlignment="Stretch" MaxWidth="760"
                  IsVisible="{Binding IsConvertTab}">

        <StackPanel Spacing="4">
          <TextBlock Text="Convertir" Classes="heading" />
          <TextBlock Text="Redimensiona y convierte una imagen, sin que salga de esta maquina."
                     Classes="muted" />
        </StackPanel>

        <Border Classes="panel" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Presets" Classes="eyebrow" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding HasPresets}">
              <ComboBox Grid.Column="0" ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPresetName}"
                        PlaceholderText="Elegir un preset guardado..." HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Classes="ghost" Content="Eliminar" Command="{Binding DeleteSelectedPresetCommand}"
                      IsVisible="{Binding SelectedPresetName, Converter={x:Static convData:ObjectConverters.IsNotNull}}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Grid.Column="0" Text="{Binding NewPresetName}" PlaceholderText="Nombre para guardar el ajuste actual..." />
              <Button Grid.Column="1" Classes="accent-outline" Content="Guardar como preset" Command="{Binding SavePresetCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border x:Name="DropZone" Classes="dropzone" Padding="24" MinHeight="140">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Spacing="10" IsVisible="{Binding !HasSource}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <Canvas Width="30" Height="30" HorizontalAlignment="Center">
                <Path Data="M15 22V9M9.5 14.5 15 9l5.5 5.5M6 24h18"
                      Stroke="{DynamicResource FraguaTextMutedBrush}" StrokeThickness="1.8"
                      StrokeLineCap="Round" StrokeJoin="Round" />
              </Canvas>
              <TextBlock Text="Solta una imagen aca" HorizontalAlignment="Center" FontWeight="Medium" />
              <TextBlock Text="o hace clic para elegirla" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Miniatura real, no solo la ruta como texto. -->
            <Border Grid.Column="0" Width="96" Height="96" CornerRadius="{DynamicResource RadiusMd}"
                    Background="{DynamicResource FraguaFieldBrush}" ClipToBounds="True"
                    IsVisible="{Binding HasSource}" Margin="0,0,18,0">
              <Image Source="{Binding SourcePreview}" Stretch="UniformToFill" IsVisible="{Binding HasSourcePreview}" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding HasSource}"
                        VerticalAlignment="Center" MinWidth="0">
              <TextBlock Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis"
                         MaxLines="1" FontWeight="Medium" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="muted">
                  <Run Text="{Binding SourceAsset.WidthPixels}" />
                  <Run Text="×" />
                  <Run Text="{Binding SourceAsset.HeightPixels}" />
                  <Run Text="px" />
                </TextBlock>
                <TextBlock Classes="muted"
                           Text="{Binding SourceAsset.SizeBytes, Converter={StaticResource ByteSize}}" />
              </StackPanel>
            </StackPanel>

            <Button Grid.Column="2" Classes="ghost" Content="Elegir..." Click="OnBrowseClick"
                    VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="18">

            <TextBlock Text="Ajustes basicos" Classes="eyebrow" />

            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox IsChecked="{Binding ResizeEnabled}" Content="Redimensionar" />
              </StackPanel>

              <ItemsControl x:Name="ResizeModeList" ItemsSource="{Binding ResizeModeOptions}" IsEnabled="{Binding ResizeEnabled}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ResizeModeOption">
                    <Button Classes="option-card" Classes.active="{Binding IsSelected}" Margin="3"
                            Command="{Binding #ResizeModeList.((vm:ConvertViewModel)DataContext).SelectResizeModeCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="option-badge"><TextBlock Text="{Binding Badge}" /></Border>
                        <StackPanel Spacing="0">
                          <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="{DynamicResource TextSm}" />
                          <TextBlock Text="{Binding Hint}" Classes="option-hint" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="6" IsVisible="{Binding IsDownloadingModel}">
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding ModelDownloadProgress}"
                             HorizontalAlignment="Stretch" Height="8" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Descargando modelo..." />
                  <TextBlock Text="{Binding ModelDownloadProgress, Converter={StaticResource Percent}}"
                             FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource FraguaEmberBrush}" />
                </StackPanel>
              </StackPanel>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsEnabled="{Binding ResizeEnabled}">
                <TextBox Grid.Column="0" Text="{Binding WidthText}"
                         PlaceholderText="Ancho" IsVisible="{Binding !IsPercentageMode}" />
                <TextBox Grid.Column="0" Text="{Binding WidthText}"
                         PlaceholderText="Porcentaje, ej. 50" IsVisible="{Binding IsPercentageMode}" />
                <TextBox Grid.Column="1" Text="{Binding HeightText}" PlaceholderText="Alto"
                         IsVisible="{Binding !IsPercentageMode}" />
              </Grid>

              <StackPanel Spacing="10" IsEnabled="{Binding ResizeEnabled}">
                <TextBlock Text="Plantillas para redes sociales" Classes="eyebrow" />
                <ItemsControl x:Name="SocialPresetList" ItemsSource="{Binding SocialPresetOptions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SocialPresetOption">
                      <Button Classes="option-card" Margin="3"
                              Command="{Binding #SocialPresetList.((vm:ConvertViewModel)DataContext).SelectSocialPresetCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border Classes="option-badge">
                            <Viewbox Width="16" Height="16">
                              <Canvas Width="24" Height="24">
                                <Path Fill="{Binding IconBrush}" Data="{Binding Icon}" />
                              </Canvas>
                            </Viewbox>
                          </Border>
                          <StackPanel Spacing="0">
                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="{DynamicResource TextSm}" />
                            <TextBlock Text="{Binding Hint}" Classes="option-hint" FontFamily="{DynamicResource FontMono}" />
                          </StackPanel>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>

            <Separator Background="{DynamicResource FraguaLineBrush}" Height="1" />

            <StackPanel Spacing="10" IsVisible="{Binding !VectorizeEnabled}">
              <TextBlock Text="Formato de salida" Classes="eyebrow" />
              <ItemsControl x:Name="FormatOptionsList" ItemsSource="{Binding FormatOptions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:FormatOption">
                    <Button Classes="option-card" Classes.active="{Binding IsSelected}" Margin="3"
                            Command="{Binding #FormatOptionsList.((vm:ConvertViewModel)DataContext).SelectFormatCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="option-badge"><TextBlock Text="{Binding Badge}" /></Border>
                        <StackPanel Spacing="0">
                          <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="{DynamicResource TextSm}" />
                          <TextBlock Text="{Binding Hint}" Classes="option-hint" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Separator Background="{DynamicResource FraguaLineBrush}" Height="1" />

            <StackPanel Spacing="10" IsVisible="{Binding !VectorizeEnabled}">
              <CheckBox IsChecked="{Binding OptimizeEnabled}" Content="Optimizar" />
              <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding OptimizeEnabled}" Width="380" HorizontalAlignment="Left">
                <Slider Grid.Column="0" Minimum="1" Maximum="100" Value="{Binding OptimizeQuality}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding OptimizeQuality}" FontFamily="{DynamicResource FontMono}"
                           VerticalAlignment="Center" Margin="10,0,0,0" Width="30" TextAlignment="Right" />
              </Grid>
              <TextBlock Classes="muted" Text="Calidad mas baja, archivo mas liviano. Tambien saca metadatos (EXIF, ubicacion, camara)." />
            </StackPanel>

            <Separator Background="{DynamicResource FraguaLineBrush}" Height="1" />

            <!-- Agrupadas aparte: son las que tardan (descargan un modelo la
                 primera vez, corren IA local) o cambian la salida por
                 completo (Vectorizar). El fondo distinto marca que no pesan
                 lo mismo que Redimensionar u Optimizar. -->
            <Border Classes="panel" Background="{DynamicResource FraguaCanvasBrush}" Padding="16">
              <StackPanel Spacing="14">
                <TextBlock Text="Funciones con IA (mas lentas)" Classes="eyebrow" />

                <StackPanel Spacing="10">
                  <CheckBox IsChecked="{Binding RemoveBackgroundEnabled}" Content="Quitar fondo (IA local)" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="Segmentacion local, sin nube. La primera vez descarga el modelo (43 MB) una sola vez." />

                  <StackPanel Spacing="6" IsVisible="{Binding IsDownloadingModel}">
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ModelDownloadProgress}"
                                 HorizontalAlignment="Stretch" Height="8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Descargando modelo..." />
                      <TextBlock Text="{Binding ModelDownloadProgress, Converter={StaticResource Percent}}"
                                 FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource FraguaEmberBrush}" />
                    </StackPanel>
                  </StackPanel>

                  <TextBlock Classes="muted" Foreground="{DynamicResource FraguaErrorBrush}"
                             Text="{Binding ModelDownloadError}"
                             IsVisible="{Binding ModelDownloadError, Converter={x:Static convData:ObjectConverters.IsNotNull}}"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Separator Background="{DynamicResource FraguaLineBrush}" Height="1" />

                <StackPanel Spacing="10">
                  <CheckBox IsChecked="{Binding VectorizeEnabled}" Content="Vectorizar (SVG)" />
                  <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding VectorizeEnabled}" Width="380" HorizontalAlignment="Left">
                    <Slider Grid.Column="0" Minimum="4" Maximum="64" Value="{Binding VectorizeColors}"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding VectorizeColors}" FontFamily="{DynamicResource FontMono}"
                               VerticalAlignment="Center" Margin="10,0,0,0" Width="30" TextAlignment="Right" />
                  </Grid>
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="Para logos y arte plano, no fotografias. Menos colores da un SVG mas limpio. Reemplaza el formato de salida y Optimizar." />
                </StackPanel>

                <Separator Background="{DynamicResource FraguaLineBrush}" Height="1" />

                <StackPanel Spacing="10">
                  <CheckBox IsChecked="{Binding UpscaleEnabled}" Content="Mejorar calidad (IA local, x4)" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="Super-resolucion local, sin nube. La primera vez descarga el modelo (unos 60 MB) una sola vez. En fotos grandes puede tardar varios minutos: corre en la CPU, sin acelerar por GPU." />

                  <StackPanel Spacing="6" IsVisible="{Binding IsDownloadingUpscaleModel}">
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding UpscaleModelDownloadProgress}"
                                 HorizontalAlignment="Stretch" Height="8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Descargando modelo..." />
                      <TextBlock Text="{Binding UpscaleModelDownloadProgress, Converter={StaticResource Percent}}"
                                 FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource FraguaEmberBrush}" />
                    </StackPanel>
                  </StackPanel>

                  <TextBlock Classes="muted" Foreground="{DynamicResource FraguaErrorBrush}"
                             Text="{Binding UpscaleModelDownloadError}"
                             IsVisible="{Binding UpscaleModelDownloadError, Converter={x:Static convData:ObjectConverters.IsNotNull}}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Separator Background="{DynamicResource FraguaLineBrush}" Height="1" />

            <StackPanel Spacing="10" IsVisible="{Binding !VectorizeEnabled}">
              <CheckBox IsChecked="{Binding WatermarkEnabled}" Content="Marca de agua" />
              <StackPanel Spacing="10" IsEnabled="{Binding WatermarkEnabled}">
                <TextBox Text="{Binding WatermarkText}" PlaceholderText="Texto de la marca de agua" />

                <ItemsControl x:Name="WatermarkPositionList" ItemsSource="{Binding WatermarkPositionOptions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:WatermarkPositionOption">
                      <Button Classes="option-card" Classes.active="{Binding IsSelected}" Margin="3"
                              Command="{Binding #WatermarkPositionList.((vm:ConvertViewModel)DataContext).SelectWatermarkPositionCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border Classes="option-badge"><TextBlock Text="{Binding Badge}" /></Border>
                          <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="{DynamicResource TextSm}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,Auto">
                  <Slider Grid.Column="0" Minimum="0.1" Maximum="1" Value="{Binding WatermarkOpacity}"
                          VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding WatermarkOpacity, Converter={StaticResource Percent}}"
                             FontFamily="{DynamicResource FontMono}" VerticalAlignment="Center"
                             Margin="10,0,0,0" Width="45" TextAlignment="Right" />
                </Grid>
              </StackPanel>
            </StackPanel>

          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="Convertir" Command="{Binding ConvertCommand}"
                  HorizontalAlignment="Left" IsEnabled="{Binding !IsConverting}" />
          <Button Classes="ghost" Content="Cancelar" Command="{Binding CancelConvertCommand}"
                  IsVisible="{Binding IsConverting}" />
        </StackPanel>

        <!-- Progreso determinado: se llena segun el paso real del pipeline,
             no una animacion que finge avanzar. -->
        <StackPanel Spacing="8" IsVisible="{Binding IsConverting}" HorizontalAlignment="Stretch">
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}"
                       HorizontalAlignment="Stretch" Height="10">
            <ProgressBar.Transitions>
              <Transitions>
                <DoubleTransition Property="Value" Duration="0:0:0.25" Easing="CubicEaseOut" />
              </Transitions>
            </ProgressBar.Transitions>
          </ProgressBar>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding ProgressStepName}" FontWeight="Medium" />
            <TextBlock Text="{Binding ProgressFraction, Converter={StaticResource Percent}}"
                       FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource FraguaEmberBrush}" />
          </StackPanel>
        </StackPanel>

        <Border Classes="panel" Padding="20" IsVisible="{Binding HasResult}">
          <Grid ColumnDefinitions="*,Auto,*">
            <StackPanel Grid.Column="0" Spacing="10">
              <Border Width="120" Height="90" CornerRadius="{DynamicResource RadiusSm}"
                      Background="{DynamicResource FraguaFieldBrush}" ClipToBounds="True">
                <Image Source="{Binding SourcePreview}" Stretch="UniformToFill" IsVisible="{Binding HasSourcePreview}" />
              </Border>
              <StackPanel Spacing="4">
                <TextBlock Text="Antes" Classes="eyebrow" />
                <TextBlock Classes="figure"
                           Text="{Binding SourceAsset.SizeBytes, Converter={StaticResource ByteSize}}" />
                <TextBlock Classes="muted">
                  <Run Text="{Binding SourceAsset.WidthPixels}" />
                  <Run Text="×" />
                  <Run Text="{Binding SourceAsset.HeightPixels}" />
                </TextBlock>
              </StackPanel>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Center" Margin="20,0"
                       Foreground="{DynamicResource FraguaEmberBrush}" FontSize="{DynamicResource TextXl}" />

            <StackPanel Grid.Column="2" Spacing="10" HorizontalAlignment="Right">
              <Border Width="120" Height="90" CornerRadius="{DynamicResource RadiusSm}"
                      Background="{DynamicResource FraguaFieldBrush}" ClipToBounds="True"
                      BorderBrush="{DynamicResource FraguaEmberBrush}" BorderThickness="1.5">
                <Image Source="{Binding ResultPreview}" Stretch="UniformToFill" IsVisible="{Binding HasResultPreview}" />
              </Border>
              <StackPanel Spacing="4" HorizontalAlignment="Right">
                <TextBlock Text="Despues" Classes="eyebrow" HorizontalAlignment="Right" />
                <TextBlock Classes="figure" HorizontalAlignment="Right"
                           Foreground="{DynamicResource FraguaEmberBrush}"
                           Text="{Binding ResultAsset.SizeBytes, Converter={StaticResource ByteSize}}" />
                <TextBlock Classes="muted" HorizontalAlignment="Right">
                  <Run Text="{Binding ResultAsset.WidthPixels}" />
                  <Run Text="×" />
                  <Run Text="{Binding ResultAsset.HeightPixels}" />
                </TextBlock>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static convData:ObjectConverters.IsNotNull}}"
                   Foreground="{Binding LastRunFailed, Converter={StaticResource StatusBrush}}"
                   FontSize="{DynamicResource TextSm}" />

      </StackPanel>

      <!-- Pestana Lotes: convierte todos los archivos de una carpeta con el
           mismo ajuste de redimension y formato de la pestana Convertir,
           corriendo sobre el mismo pipeline probado (RunBatchAsync). -->
      <StackPanel Margin="32,28" Spacing="20" HorizontalAlignment="Stretch" MaxWidth="760"
                  IsVisible="{Binding IsBatchTab}">

        <StackPanel Spacing="4">
          <TextBlock Text="Lotes" Classes="heading" />
          <TextBlock Classes="muted"
                     Text="Convierte todos los archivos de una carpeta con el mismo ajuste de arriba." />
        </StackPanel>

        <Border Classes="panel" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Presets" Classes="eyebrow" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding HasPresets}">
              <ComboBox Grid.Column="0" ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPresetName}"
                        PlaceholderText="Elegir un preset guardado..." HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Classes="ghost" Content="Eliminar" Command="{Binding DeleteSelectedPresetCommand}"
                      IsVisible="{Binding SelectedPresetName, Converter={x:Static convData:ObjectConverters.IsNotNull}}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Grid.Column="0" Text="{Binding NewPresetName}" PlaceholderText="Nombre para guardar el ajuste actual..." />
              <Button Grid.Column="1" Classes="accent-outline" Content="Guardar como preset" Command="{Binding SavePresetCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="20">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding BatchFolder}" IsVisible="{Binding HasBatchFolder}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="Ninguna carpeta elegida" Classes="muted" IsVisible="{Binding !HasBatchFolder}" />
              <TextBlock Classes="muted" IsVisible="{Binding HasBatchFiles}">
                <Run Text="{Binding BatchFiles.Count}" />
                <Run Text="archivos" />
              </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="Elegir carpeta..." Click="OnBrowseFolderClick"
                    VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Mismo ajuste que Convertir: es un solo pipeline, no dos
             configuraciones separadas que se puedan desincronizar. -->
        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="18">
            <TextBlock Text="Ajustes basicos" Classes="eyebrow" />
            <StackPanel Spacing="10">
              <CheckBox IsChecked="{Binding ResizeEnabled}" Content="Redimensionar" />
              <ItemsControl x:Name="ResizeModeListBatch" ItemsSource="{Binding ResizeModeOptions}" IsEnabled="{Binding ResizeEnabled}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ResizeModeOption">
                    <Button Classes="option-card" Classes.active="{Binding IsSelected}" Margin="3"
                            Command="{Binding #ResizeModeListBatch.((vm:ConvertViewModel)DataContext).SelectResizeModeCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="option-badge"><TextBlock Text="{Binding Badge}" /></Border>
                        <StackPanel Spacing="0">
                          <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="{DynamicResource TextSm}" />
                          <TextBlock Text="{Binding Hint}" Classes="option-hint" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="6" IsVisible="{Binding IsDownloadingModel}">
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding ModelDownloadProgress}"
                             HorizontalAlignment="Stretch" Height="8" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Descargando modelo..." />
                  <TextBlock Text="{Binding ModelDownloadProgress, Converter={StaticResource Percent}}"
                             FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource FraguaEmberBrush}" />
                </StackPanel>
              </StackPanel>

              <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsEnabled="{Binding ResizeEnabled}">
                <TextBox Grid.Column="0" Text="{Binding WidthText}"
                         PlaceholderText="Ancho" IsVisible="{Binding !IsPercentageMode}" />
                <TextBox Grid.Column="0" Text="{Binding WidthText}"
                         PlaceholderText="Porcentaje, ej. 50" IsVisible="{Binding IsPercentageMode}" />
                <TextBox Grid.Column="1" Text="{Binding HeightText}" PlaceholderText="Alto"
                         IsVisible="{Binding !IsPercentageMode}" />
              </Grid>

              <StackPanel Spacing="10" IsEnabled="{Binding ResizeEnabled}">
                <TextBlock Text="Plantillas para redes sociales" Classes="eyebrow" />
                <ItemsControl x:Name="SocialPresetListBatch" ItemsSource="{Binding SocialPresetOptions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:SocialPresetOption">
                      <Button Classes="option-card" Margin="3"
                              Command="{Binding #SocialPresetListBatch.((vm:ConvertViewModel)DataContext).SelectSocialPresetCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border Classes="option-badge">
                            <Viewbox Width="16" Height="16">
                              <Canvas Width="24" Height="24">
                                <Path Fill="{Binding IconBrush}" Data="{Binding Icon}" />
                              </Canvas>
                            </Viewbox>
                          </Border>
                          <StackPanel Spacing="0">
                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="{DynamicResource TextSm}" />
                            <TextBlock Text="{Binding Hint}" Classes="option-hint" FontFamily="{DynamicResource FontMono}" />
                          </StackPanel>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
            <Separator Background="{DynamicResource FraguaLineBrush}" Height="1" />
            <StackPanel Spacing="10" IsVisible="{Binding !VectorizeEnabled}">
              <TextBlock Text="Formato de salida" Classes="eyebrow" />
              <ItemsControl x:Name="FormatOptionsListBatch" ItemsSource="{Binding FormatOptions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:FormatOption">
                    <Button Classes="option-card" Classes.active="{Binding IsSelected}" Margin="3"
                            Command="{Binding #FormatOptionsListBatch.((vm:ConvertViewModel)DataContext).SelectFormatCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="option-badge"><TextBlock Text="{Binding Badge}" /></Border>
                        <StackPanel Spacing="0">
                          <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="{DynamicResource TextSm}" />
                          <TextBlock Text="{Binding Hint}" Classes="option-hint" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Separator Background="{DynamicResource FraguaLineBrush}" Height="1" />

            <StackPanel Spacing="10" IsVisible="{Binding !VectorizeEnabled}">
              <CheckBox IsChecked="{Binding OptimizeEnabled}" Content="Optimizar" />
              <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding OptimizeEnabled}" Width="380" HorizontalAlignment="Left">
                <Slider Grid.Column="0" Minimum="1" Maximum="100" Value="{Binding OptimizeQuality}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding OptimizeQuality}" FontFamily="{DynamicResource FontMono}"
                           VerticalAlignment="Center" Margin="10,0,0,0" Width="30" TextAlignment="Right" />
              </Grid>
              <TextBlock Classes="muted" Text="Calidad mas baja, archivo mas liviano. Tambien saca metadatos (EXIF, ubicacion, camara)." />
            </StackPanel>

            <Separator Background="{DynamicResource FraguaLineBrush}" Height="1" />

            <Border Classes="panel" Background="{DynamicResource FraguaCanvasBrush}" Padding="16">
              <StackPanel Spacing="14">
                <TextBlock Text="Funciones con IA (mas lentas)" Classes="eyebrow" />

                <StackPanel Spacing="10">
                  <CheckBox IsChecked="{Binding RemoveBackgroundEnabled}" Content="Quitar fondo (IA local)" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="Segmentacion local, sin nube. La primera vez descarga el modelo (43 MB) una sola vez." />

                  <StackPanel Spacing="6" IsVisible="{Binding IsDownloadingModel}">
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding ModelDownloadProgress}"
                                 HorizontalAlignment="Stretch" Height="8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Descargando modelo..." />
                      <TextBlock Text="{Binding ModelDownloadProgress, Converter={StaticResource Percent}}"
                                 FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource FraguaEmberBrush}" />
                    </StackPanel>
                  </StackPanel>

                  <TextBlock Classes="muted" Foreground="{DynamicResource FraguaErrorBrush}"
                             Text="{Binding ModelDownloadError}"
                             IsVisible="{Binding ModelDownloadError, Converter={x:Static convData:ObjectConverters.IsNotNull}}"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Separator Background="{DynamicResource FraguaLineBrush}" Height="1" />

                <StackPanel Spacing="10">
                  <CheckBox IsChecked="{Binding VectorizeEnabled}" Content="Vectorizar (SVG)" />
                  <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding VectorizeEnabled}" Width="380" HorizontalAlignment="Left">
                    <Slider Grid.Column="0" Minimum="4" Maximum="64" Value="{Binding VectorizeColors}"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding VectorizeColors}" FontFamily="{DynamicResource FontMono}"
                               VerticalAlignment="Center" Margin="10,0,0,0" Width="30" TextAlignment="Right" />
                  </Grid>
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="Para logos y arte plano, no fotografias. Menos colores da un SVG mas limpio. Reemplaza el formato de salida y Optimizar." />
                </StackPanel>

                <Separator Background="{DynamicResource FraguaLineBrush}" Height="1" />

                <StackPanel Spacing="10">
                  <CheckBox IsChecked="{Binding UpscaleEnabled}" Content="Mejorar calidad (IA local, x4)" />
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="Super-resolucion local, sin nube. La primera vez descarga el modelo (unos 60 MB) una sola vez. En fotos grandes puede tardar varios minutos: corre en la CPU, sin acelerar por GPU." />

                  <StackPanel Spacing="6" IsVisible="{Binding IsDownloadingUpscaleModel}">
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding UpscaleModelDownloadProgress}"
                                 HorizontalAlignment="Stretch" Height="8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="Descargando modelo..." />
                      <TextBlock Text="{Binding UpscaleModelDownloadProgress, Converter={StaticResource Percent}}"
                                 FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource FraguaEmberBrush}" />
                    </StackPanel>
                  </StackPanel>

                  <TextBlock Classes="muted" Foreground="{DynamicResource FraguaErrorBrush}"
                             Text="{Binding UpscaleModelDownloadError}"
                             IsVisible="{Binding UpscaleModelDownloadError, Converter={x:Static convData:ObjectConverters.IsNotNull}}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Separator Background="{DynamicResource FraguaLineBrush}" Height="1" />

            <StackPanel Spacing="10" IsVisible="{Binding !VectorizeEnabled}">
              <CheckBox IsChecked="{Binding WatermarkEnabled}" Content="Marca de agua" />
              <StackPanel Spacing="10" IsEnabled="{Binding WatermarkEnabled}">
                <TextBox Text="{Binding WatermarkText}" PlaceholderText="Texto de la marca de agua" />

                <ItemsControl x:Name="WatermarkPositionListBatch" ItemsSource="{Binding WatermarkPositionOptions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:WatermarkPositionOption">
                      <Button Classes="option-card" Classes.active="{Binding IsSelected}" Margin="3"
                              Command="{Binding #WatermarkPositionListBatch.((vm:ConvertViewModel)DataContext).SelectWatermarkPositionCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border Classes="option-badge"><TextBlock Text="{Binding Badge}" /></Border>
                          <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="{DynamicResource TextSm}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,Auto">
                  <Slider Grid.Column="0" Minimum="0.1" Maximum="1" Value="{Binding WatermarkOpacity}"
                          VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding WatermarkOpacity, Converter={StaticResource Percent}}"
                             FontFamily="{DynamicResource FontMono}" VerticalAlignment="Center"
                             Margin="10,0,0,0" Width="45" TextAlignment="Right" />
                </Grid>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasBatchFiles}">
          <Button Classes="primary" Content="Iniciar conversion por lotes" Command="{Binding StartBatchCommand}"
                  HorizontalAlignment="Left" IsEnabled="{Binding !IsBatchRunning}" />
          <Button Classes="ghost" Content="Cancelar" Command="{Binding CancelBatchCommand}"
                  IsVisible="{Binding IsBatchRunning}" />
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding IsBatchRunning}" HorizontalAlignment="Stretch">
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding BatchProgressFraction}"
                       HorizontalAlignment="Stretch" Height="10">
            <ProgressBar.Transitions>
              <Transitions>
                <DoubleTransition Property="Value" Duration="0:0:0.25" Easing="CubicEaseOut" />
              </Transitions>
            </ProgressBar.Transitions>
          </ProgressBar>
          <TextBlock FontFamily="{DynamicResource FontMono}" FontWeight="Medium"
                     Foreground="{DynamicResource FraguaEmberBrush}"
                     Text="{Binding BatchProgressFraction, Converter={StaticResource Percent}}" />
        </StackPanel>

        <Border Classes="panel" Padding="4" IsVisible="{Binding HasBatchFiles}" MaxHeight="320">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding BatchFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:BatchFileItem">
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,8">
                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,10,0"
                             Fill="{Binding Status, Converter={StaticResource BatchStatus}}" />
                    <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" VerticalAlignment="Center"
                               MaxWidth="140" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding HasBatchResults}">
          <TextBlock Classes="muted">
            <Run Text="{Binding BatchCompletedCount}" />
            <Run Text="listos" />
          </TextBlock>
          <TextBlock Classes="muted" Foreground="{DynamicResource FraguaErrorBrush}" IsVisible="{Binding HasBatchFailures}">
            <Run Text="{Binding BatchFailedCount}" />
            <Run Text="con error" />
          </TextBlock>
        </StackPanel>

      </StackPanel>

      <!-- Pestana Iconos: de una imagen (logo, foto) genera todo el set de
           tamanos que pide un icono de escritorio o un favicon. Usa la
           misma imagen cargada, no un dropzone con estado propio. -->
      <StackPanel Margin="32,28" Spacing="20" HorizontalAlignment="Stretch" MaxWidth="760"
                  IsVisible="{Binding IsIconsTab}">

        <StackPanel Spacing="4">
          <TextBlock Text="Iconos" Classes="heading" />
          <TextBlock Text="De una imagen, todo el set de tamanos para un icono de escritorio o un favicon."
                     Classes="muted" />
        </StackPanel>

        <Border x:Name="IconsDropZone" Classes="dropzone" Padding="24" MinHeight="140">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Spacing="10" IsVisible="{Binding !HasSource}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <Canvas Width="30" Height="30" HorizontalAlignment="Center">
                <Path Data="M15 22V9M9.5 14.5 15 9l5.5 5.5M6 24h18"
                      Stroke="{DynamicResource FraguaTextMutedBrush}" StrokeThickness="1.8"
                      StrokeLineCap="Round" StrokeJoin="Round" />
              </Canvas>
              <TextBlock Text="Solta una imagen aca" HorizontalAlignment="Center" FontWeight="Medium" />
              <TextBlock Text="o hace clic para elegirla" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="0" Width="96" Height="96" CornerRadius="{DynamicResource RadiusMd}"
                    Background="{DynamicResource FraguaFieldBrush}" ClipToBounds="True"
                    IsVisible="{Binding HasSource}" Margin="0,0,18,0">
              <Image Source="{Binding SourcePreview}" Stretch="UniformToFill" IsVisible="{Binding HasSourcePreview}" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding HasSource}"
                        VerticalAlignment="Center" MinWidth="0">
              <TextBlock Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis"
                         MaxLines="1" FontWeight="Medium" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="muted">
                  <Run Text="{Binding SourceAsset.WidthPixels}" />
                  <Run Text="×" />
                  <Run Text="{Binding SourceAsset.HeightPixels}" />
                  <Run Text="px" />
                </TextBlock>
                <TextBlock Classes="muted"
                           Text="{Binding SourceAsset.SizeBytes, Converter={StaticResource ByteSize}}" />
              </StackPanel>
            </StackPanel>

            <Button Grid.Column="2" Classes="ghost" Content="Elegir..." Click="OnBrowseClick"
                    VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="14">
            <StackPanel Spacing="4">
              <TextBlock Text="Tamanos generados" Classes="eyebrow" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="16, 32, 48, 64, 128, 256 y 512 px en PNG. Si la imagen no es cuadrada, se centra sobre fondo transparente." />
            </StackPanel>
            <CheckBox IsChecked="{Binding IncludeIco}" Content="Incluir un .ico combinado (Windows)" />
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button Classes="primary" Content="Generar iconos" Command="{Binding GenerateIconsCommand}"
                  HorizontalAlignment="Left" IsEnabled="{Binding !IsGeneratingIcons}" />
          <TextBlock Text="Generando..." VerticalAlignment="Center" Classes="muted"
                     IsVisible="{Binding IsGeneratingIcons}" />
        </StackPanel>

        <TextBlock Classes="muted" Foreground="{DynamicResource FraguaErrorBrush}"
                   Text="{Binding IconGenerationError}"
                   IsVisible="{Binding IconGenerationError, Converter={x:Static convData:ObjectConverters.IsNotNull}}"
                   TextWrapping="Wrap" />

        <Border Classes="panel" Padding="20" IsVisible="{Binding HasGeneratedIcons}">
          <StackPanel Spacing="10">
            <TextBlock Text="Generado" Classes="eyebrow" />
            <ItemsControl ItemsSource="{Binding GeneratedIconFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontFamily="{DynamicResource FontMono}"
                             FontSize="{DynamicResource TextSm}"
                             Foreground="{DynamicResource FraguaTextMediumBrush}" Margin="0,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      </StackPanel>

      <!-- Pestana Metadatos: que datos EXIF trae la imagen cargada, y
           cuales sacar, campo por campo (a diferencia de Optimizar, que
           los saca todos de una). Usa la misma imagen cargada. -->
      <StackPanel Margin="32,28" Spacing="20" HorizontalAlignment="Stretch" MaxWidth="760"
                  IsVisible="{Binding IsMetadataTab}">

        <StackPanel Spacing="4">
          <TextBlock Text="Metadatos" Classes="heading" />
          <TextBlock Text="Que datos EXIF trae la imagen cargada, y cuales sacar (ubicacion, camara, fecha)."
                     Classes="muted" />
        </StackPanel>

        <Border x:Name="MetadataDropZone" Classes="dropzone" Padding="24" MinHeight="140">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Spacing="10" IsVisible="{Binding !HasSource}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <Canvas Width="30" Height="30" HorizontalAlignment="Center">
                <Path Data="M15 22V9M9.5 14.5 15 9l5.5 5.5M6 24h18"
                      Stroke="{DynamicResource FraguaTextMutedBrush}" StrokeThickness="1.8"
                      StrokeLineCap="Round" StrokeJoin="Round" />
              </Canvas>
              <TextBlock Text="Solta una imagen aca" HorizontalAlignment="Center" FontWeight="Medium" />
              <TextBlock Text="o hace clic para elegirla" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="0" Width="96" Height="96" CornerRadius="{DynamicResource RadiusMd}"
                    Background="{DynamicResource FraguaFieldBrush}" ClipToBounds="True"
                    IsVisible="{Binding HasSource}" Margin="0,0,18,0">
              <Image Source="{Binding SourcePreview}" Stretch="UniformToFill" IsVisible="{Binding HasSourcePreview}" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding HasSource}"
                        VerticalAlignment="Center" MinWidth="0">
              <TextBlock Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis"
                         MaxLines="1" FontWeight="Medium" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="muted">
                  <Run Text="{Binding SourceAsset.WidthPixels}" />
                  <Run Text="×" />
                  <Run Text="{Binding SourceAsset.HeightPixels}" />
                  <Run Text="px" />
                </TextBlock>
                <TextBlock Classes="muted"
                           Text="{Binding SourceAsset.SizeBytes, Converter={StaticResource ByteSize}}" />
              </StackPanel>
            </StackPanel>

            <Button Grid.Column="2" Classes="ghost" Content="Elegir..." Click="OnBrowseClick"
                    VerticalAlignment="Center" />
          </Grid>
        </Border>

        <StackPanel Spacing="16" IsVisible="{Binding HasSource}">
          <TextBlock Text="Leyendo metadatos..." Classes="muted" IsVisible="{Binding IsReadingMetadata}" />

          <Border Classes="panel" Padding="28"
                  IsVisible="{Binding !IsReadingMetadata}">
            <StackPanel Spacing="16">
              <StackPanel Spacing="10" IsVisible="{Binding !HasMetadataFields}">
                <TextBlock Text="Esta imagen no tiene metadatos EXIF." Classes="muted" HorizontalAlignment="Center" />
              </StackPanel>

              <StackPanel Spacing="14" IsVisible="{Binding HasMetadataFields}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Classes="ghost" Content="Marcar todo" Command="{Binding SelectAllMetadataCommand}" />
                  <Button Classes="ghost" Content="Desmarcar todo" Command="{Binding DeselectAllMetadataCommand}" />
                </StackPanel>

                <Border Classes="panel" Padding="4" MaxHeight="320">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding MetadataFields}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MetadataFieldItem">
                          <Grid ColumnDefinitions="Auto,140,*" Margin="12,8" ColumnSpacing="12">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" />
                            <TextBlock Grid.Column="1" Text="{Binding Tag}" FontFamily="{DynamicResource FontMono}"
                                       FontSize="{DynamicResource TextSm}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Value}" Classes="muted"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>

                <Button Classes="primary" Content="Sacar campos marcados"
                        Command="{Binding RemoveSelectedMetadataCommand}"
                        HorizontalAlignment="Left" IsEnabled="{Binding !IsRemovingMetadata}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Classes="muted" Foreground="{DynamicResource FraguaErrorBrush}"
                     Text="{Binding MetadataError}"
                     IsVisible="{Binding MetadataError, Converter={x:Static convData:ObjectConverters.IsNotNull}}"
                     TextWrapping="Wrap" />

          <TextBlock Classes="muted" Foreground="{DynamicResource FraguaSuccessBrush}"
                     Text="{Binding MetadataStatusMessage}"
                     IsVisible="{Binding MetadataStatusMessage, Converter={x:Static convData:ObjectConverters.IsNotNull}}"
                     TextWrapping="Wrap" />
        </StackPanel>

      </StackPanel>

      <!-- Pestana Paleta: colores dominantes de la imagen cargada, ignorando
           pixeles transparentes para no contar "negro" falso en logos con
           fondo transparente. Misma imagen cargada que las demas pestanas. -->
      <StackPanel Margin="32,28" Spacing="20" HorizontalAlignment="Stretch" MaxWidth="760"
                  IsVisible="{Binding IsPaletteTab}">

        <StackPanel Spacing="4">
          <TextBlock Text="Paleta" Classes="heading" />
          <TextBlock Text="Los colores dominantes de la imagen cargada, de mas a menos presencia."
                     Classes="muted" />
        </StackPanel>

        <Border x:Name="PaletteDropZone" Classes="dropzone" Padding="24" MinHeight="140">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Spacing="10" IsVisible="{Binding !HasSource}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <Canvas Width="30" Height="30" HorizontalAlignment="Center">
                <Path Data="M15 22V9M9.5 14.5 15 9l5.5 5.5M6 24h18"
                      Stroke="{DynamicResource FraguaTextMutedBrush}" StrokeThickness="1.8"
                      StrokeLineCap="Round" StrokeJoin="Round" />
              </Canvas>
              <TextBlock Text="Solta una imagen aca" HorizontalAlignment="Center" FontWeight="Medium" />
              <TextBlock Text="o hace clic para elegirla" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>

            <Border Grid.Column="0" Width="96" Height="96" CornerRadius="{DynamicResource RadiusMd}"
                    Background="{DynamicResource FraguaFieldBrush}" ClipToBounds="True"
                    IsVisible="{Binding HasSource}" Margin="0,0,18,0">
              <Image Source="{Binding SourcePreview}" Stretch="UniformToFill" IsVisible="{Binding HasSourcePreview}" />
            </Border>

            <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding HasSource}"
                        VerticalAlignment="Center" MinWidth="0">
              <TextBlock Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis"
                         MaxLines="1" FontWeight="Medium" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="muted">
                  <Run Text="{Binding SourceAsset.WidthPixels}" />
                  <Run Text="×" />
                  <Run Text="{Binding SourceAsset.HeightPixels}" />
                  <Run Text="px" />
                </TextBlock>
                <TextBlock Classes="muted"
                           Text="{Binding SourceAsset.SizeBytes, Converter={StaticResource ByteSize}}" />
              </StackPanel>
            </StackPanel>

            <Button Grid.Column="2" Classes="ghost" Content="Elegir..." Click="OnBrowseClick"
                    VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Classes="panel" Padding="20" IsVisible="{Binding HasSource}">
          <StackPanel Spacing="14">
            <StackPanel Spacing="4">
              <TextBlock Text="Cuentagotas" Classes="eyebrow" />
              <TextBlock Text="Hace clic en cualquier punto de la imagen para sacar ese color exacto."
                         Classes="muted" />
            </StackPanel>

            <Border Background="{DynamicResource FraguaFieldBrush}" CornerRadius="{DynamicResource RadiusMd}"
                    ClipToBounds="True" MaxHeight="320">
              <Image Source="{Binding SourcePreview}" Stretch="Uniform" Cursor="Cross"
                     PointerPressed="OnPickColorFromImage" />
            </Border>

            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"
                  IsVisible="{Binding PickedColor, Converter={x:Static convData:ObjectConverters.IsNotNull}}">
              <Border Grid.Column="0" Width="48" Height="48" CornerRadius="{DynamicResource RadiusMd}"
                      Background="{Binding PickedColor.Brush}" BorderBrush="{DynamicResource FraguaLineBrush}"
                      BorderThickness="1" />
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding PickedColor.Hex}" FontFamily="{DynamicResource FontMono}" FontWeight="Medium" />
                <TextBlock Text="{Binding PickedColor.RgbText}" Classes="muted" FontFamily="{DynamicResource FontMono}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="ghost" Content="Copiar" Tag="{Binding PickedColor.Hex}"
                      Click="OnCopyHexClick" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Classes="muted" Foreground="{DynamicResource FraguaErrorBrush}"
                       Text="{Binding EyedropperError}"
                       IsVisible="{Binding EyedropperError, Converter={x:Static convData:ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="16" IsVisible="{Binding HasSource}">
          <StackPanel Spacing="10">
            <TextBlock Text="Cantidad de colores" />
            <Grid ColumnDefinitions="*,Auto" Width="380" HorizontalAlignment="Left">
              <Slider Grid.Column="0" Minimum="2" Maximum="12" Value="{Binding PaletteColorCount}"
                      VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding PaletteColorCount}" FontFamily="{DynamicResource FontMono}"
                         VerticalAlignment="Center" Margin="10,0,0,0" Width="30" TextAlignment="Right" />
            </Grid>
          </StackPanel>

          <TextBlock Text="Sacando paleta..." Classes="muted" IsVisible="{Binding IsExtractingPalette}" />

          <Border Classes="panel" Padding="28" IsVisible="{Binding !IsExtractingPalette}">
            <StackPanel Spacing="16">
              <StackPanel Spacing="10" IsVisible="{Binding !HasPaletteColors}">
                <TextBlock Text="No se pudo sacar una paleta de esta imagen." Classes="muted" HorizontalAlignment="Center" />
              </StackPanel>

              <ItemsControl ItemsSource="{Binding PaletteColors}" IsVisible="{Binding HasPaletteColors}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:PaletteColorItem">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,6" ColumnSpacing="14">
                      <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                              Background="{Binding Brush}" BorderBrush="{DynamicResource FraguaLineBrush}"
                              BorderThickness="1" />
                      <TextBlock Grid.Column="1" Text="{Binding Hex}" FontFamily="{DynamicResource FontMono}"
                                 VerticalAlignment="Center" Width="90" />
                      <TextBlock Grid.Column="2" Text="{Binding PercentageText}" Classes="muted"
                                 VerticalAlignment="Center" FontFamily="{DynamicResource FontMono}" />
                      <Button Grid.Column="3" Classes="ghost" Content="Copiar" Tag="{Binding Hex}"
                              Click="OnCopyHexClick" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <TextBlock Classes="muted" Foreground="{DynamicResource FraguaErrorBrush}"
                     Text="{Binding PaletteError}"
                     IsVisible="{Binding PaletteError, Converter={x:Static convData:ObjectConverters.IsNotNull}}"
                     TextWrapping="Wrap" />

          <TextBlock Classes="muted" Foreground="{DynamicResource FraguaSuccessBrush}"
                     Text="{Binding PaletteStatusMessage}"
                     IsVisible="{Binding PaletteStatusMessage, Converter={x:Static convData:ObjectConverters.IsNotNull}}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Separator Background="{DynamicResource FraguaLineBrush}" Height="1" />

        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock Text="Generador de paletas" Classes="eyebrow" />
              <TextBlock Text="Arma una paleta a partir de un color base. No necesita ninguna imagen cargada."
                         Classes="muted" TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Grid.Column="0" Text="{Binding HarmonyBaseHex}" PlaceholderText="#F27636" />
              <Button Grid.Column="1" Classes="ghost" Content="Usar el del cuentagotas"
                      Command="{Binding UsePickedColorAsHarmonyBaseCommand}"
                      IsEnabled="{Binding PickedColor, Converter={x:Static convData:ObjectConverters.IsNotNull}}" />
            </Grid>

            <ItemsControl x:Name="HarmonyOptionsList" ItemsSource="{Binding HarmonyOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:HarmonyOption">
                  <Button Classes="option-card" Classes.active="{Binding IsSelected}" Margin="3"
                          Command="{Binding #HarmonyOptionsList.((vm:ConvertViewModel)DataContext).SelectHarmonyCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="option-badge"><TextBlock Text="{Binding Badge}" /></Border>
                      <StackPanel Spacing="0">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="{DynamicResource TextSm}" />
                        <TextBlock Text="{Binding Hint}" Classes="option-hint" />
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="muted" Foreground="{DynamicResource FraguaErrorBrush}"
                       Text="{Binding HarmonyError}"
                       IsVisible="{Binding HarmonyError, Converter={x:Static convData:ObjectConverters.IsNotNull}}" />

            <ItemsControl ItemsSource="{Binding HarmonyColors}" IsVisible="{Binding HasHarmonyColors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:ColorSwatchItem">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,6" ColumnSpacing="14">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                            Background="{Binding Brush}" BorderBrush="{DynamicResource FraguaLineBrush}"
                            BorderThickness="1" />
                    <TextBlock Grid.Column="1" Text="{Binding Hex}" FontFamily="{DynamicResource FontMono}"
                               VerticalAlignment="Center" Width="90" />
                    <TextBlock Grid.Column="2" Text="{Binding RgbText}" Classes="muted"
                               VerticalAlignment="Center" FontFamily="{DynamicResource FontMono}" />
                    <Button Grid.Column="3" Classes="ghost" Content="Copiar" Tag="{Binding Hex}"
                            Click="OnCopyHexClick" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="muted" Foreground="{DynamicResource FraguaSuccessBrush}"
                       Text="{Binding PaletteStatusMessage}"
                       IsVisible="{Binding PaletteStatusMessage, Converter={x:Static convData:ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>

      </StackPanel>

      <!-- Pestana Collage: junta varias imagenes sueltas en una sola
           grilla. Con espaciado en 0 y recorte activado da un sprite sheet
           bien pegado; sin recorte, un contacto que muestra cada foto
           completa. -->
      <StackPanel Margin="32,28" Spacing="20" HorizontalAlignment="Stretch" MaxWidth="760"
                  IsVisible="{Binding IsCollageTab}">

        <StackPanel Spacing="4">
          <TextBlock Text="Collage" Classes="heading" />
          <TextBlock Text="Junta varias imagenes en una sola grilla. Espaciado en 0 y Recortar activado da un sprite sheet."
                     Classes="muted" TextWrapping="Wrap" />
        </StackPanel>

        <Border x:Name="CollageDropZone" Classes="dropzone" Padding="24" MinHeight="120">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Canvas Width="30" Height="30" HorizontalAlignment="Center">
                <Path Data="M15 22V9M9.5 14.5 15 9l5.5 5.5M6 24h18"
                      Stroke="{DynamicResource FraguaTextMutedBrush}" StrokeThickness="1.8"
                      StrokeLineCap="Round" StrokeJoin="Round" />
              </Canvas>
              <TextBlock Text="Solta varias imagenes aca" HorizontalAlignment="Center" FontWeight="Medium" />
              <TextBlock Text="Se van sumando a la lista de abajo" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Content="Elegir archivos..." Click="OnBrowseCollageFilesClick"
                    VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Classes="panel" Padding="20" IsVisible="{Binding HasCollageSources}">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="eyebrow" VerticalAlignment="Center">
                <Run Text="Imagenes cargadas (" /><Run Text="{Binding CollageSources.Count}" /><Run Text=")" />
              </TextBlock>
              <Button Grid.Column="1" Classes="ghost" Content="Vaciar lista" Command="{Binding ClearCollageSourcesCommand}" />
            </Grid>

            <Border Classes="panel" Padding="4" MaxHeight="200">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding CollageSources}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:CollageSourceItem">
                      <Grid ColumnDefinitions="*,Auto" Margin="12,6">
                        <TextBlock Grid.Column="0" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="ghost" Content="Quitar"
                                Command="{Binding $parent[ItemsControl].((vm:ConvertViewModel)DataContext).RemoveCollageSourceCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="18">
            <TextBlock Text="Ajustes de grilla" Classes="eyebrow" />

            <StackPanel Spacing="8">
              <TextBlock Text="Columnas" />
              <Grid ColumnDefinitions="*,Auto" Width="380" HorizontalAlignment="Left">
                <Slider Grid.Column="0" Minimum="1" Maximum="8" Value="{Binding CollageColumns}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CollageColumns}" FontFamily="{DynamicResource FontMono}"
                           VerticalAlignment="Center" Margin="10,0,0,0" Width="30" TextAlignment="Right" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="Tamano de celda" />
              <Grid ColumnDefinitions="*,Auto" Width="380" HorizontalAlignment="Left">
                <Slider Grid.Column="0" Minimum="100" Maximum="800" Value="{Binding CollageCellSize}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CollageCellSize}" FontFamily="{DynamicResource FontMono}"
                           VerticalAlignment="Center" Margin="10,0,0,0" Width="45" TextAlignment="Right" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="Espaciado" />
              <Grid ColumnDefinitions="*,Auto" Width="380" HorizontalAlignment="Left">
                <Slider Grid.Column="0" Minimum="0" Maximum="60" Value="{Binding CollageSpacing}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CollageSpacing}" FontFamily="{DynamicResource FontMono}"
                           VerticalAlignment="Center" Margin="10,0,0,0" Width="45" TextAlignment="Right" />
              </Grid>
            </StackPanel>

            <Separator Background="{DynamicResource FraguaLineBrush}" Height="1" />

            <CheckBox IsChecked="{Binding CollageCropToFill}" Content="Recortar para llenar cada celda" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Si esta activado, cada imagen se recorta centrada para llenar su celda sin distorsionarse. Si no, se ve completa, con margen." />

            <CheckBox IsChecked="{Binding CollageTransparentBackground}" Content="Fondo transparente" />
          </StackPanel>
        </Border>

        <Button Classes="primary" Content="Crear collage" Command="{Binding ComposeCollageCommand}"
                HorizontalAlignment="Left" IsEnabled="{Binding !IsComposingCollage}" />

        <TextBlock Text="Armando el collage..." Classes="muted" IsVisible="{Binding IsComposingCollage}" />

        <TextBlock Classes="muted" Foreground="{DynamicResource FraguaErrorBrush}"
                   Text="{Binding CollageError}"
                   IsVisible="{Binding CollageError, Converter={x:Static convData:ObjectConverters.IsNotNull}}"
                   TextWrapping="Wrap" />

        <TextBlock Classes="muted" Foreground="{DynamicResource FraguaSuccessBrush}"
                   Text="{Binding CollageStatusMessage}"
                   IsVisible="{Binding CollageStatusMessage, Converter={x:Static convData:ObjectConverters.IsNotNull}}"
                   TextWrapping="Wrap" />

      </StackPanel>

      <StackPanel Margin="32,28" Spacing="20" HorizontalAlignment="Stretch"
                  IsVisible="{Binding IsHistoryTab}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4">
            <TextBlock Text="Historial" Classes="heading" />
            <TextBlock Classes="muted" Text="Lo que convertiste, guardado en este equipo. Sobrevive a cerrar la app." />
          </StackPanel>
          <Button Grid.Column="1" Classes="accent-outline" Content="Limpiar historial" Command="{Binding ClearHistoryCommand}"
                  IsVisible="{Binding HasHistory}" VerticalAlignment="Top" />
        </Grid>

        <Border Classes="panel" Padding="28" IsVisible="{Binding !HasHistory}">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <Canvas Width="28" Height="28" HorizontalAlignment="Center">
              <Ellipse Canvas.Left="2" Canvas.Top="2" Width="24" Height="24" Stroke="{DynamicResource FraguaTextMutedBrush}" StrokeThickness="1.6" />
              <Path Data="M14 7v7l5 3" Stroke="{DynamicResource FraguaEmberBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
            </Canvas>
            <TextBlock Text="Todavia no convertiste nada en esta sesion" FontWeight="Medium" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="4" IsVisible="{Binding HasHistory}" MaxHeight="440">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding History}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:HistoryEntry">
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,10">
                    <TextBlock Grid.Column="0" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Classes="muted" FontFamily="{DynamicResource FontMono}"
                               VerticalAlignment="Center" Margin="0,0,14,0">
                      <Run Text="{Binding SizeBeforeBytes, Converter={StaticResource ByteSize}}" />
                      <Run Text="→" />
                      <Run Text="{Binding SizeAfterBytes, Converter={StaticResource ByteSize}}" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding When, StringFormat={}{0:HH:mm:ss}}"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </StackPanel>

      <!-- Acerca de: creditos y tecnologias reales, no una pantalla generica. -->
      <StackPanel Margin="32,28" Spacing="20" HorizontalAlignment="Stretch"
                  IsVisible="{Binding IsAboutTab}">
        <StackPanel Spacing="4">
          <TextBlock Text="Acerca de Fragua" Classes="heading" />
          <TextBlock Text="Imagenes listas para publicar, sin que salgan de tu maquina." Classes="muted" />
        </StackPanel>

        <Border Classes="panel" Padding="28">
          <StackPanel Spacing="18">
            <StackPanel Orientation="Horizontal" Spacing="20">
              <Image Source="avares://Fragua.App/Assets/Icons/fragua-lockup.png" Width="140"
                     HorizontalAlignment="Left" />
              <TextBlock Text="v0.13.0" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,4" />
            </StackPanel>
            <Separator Background="{DynamicResource FraguaLineBrush}" Height="1" />
            <TextBlock Text="Disenado y desarrollado por Fernando Rodriguez, 2026." TextWrapping="Wrap" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Sin cuentas, sin nube, sin telemetria. El procesamiento de imagenes corre entero en esta maquina." />
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="12">
            <TextBlock Text="Tecnologia" Classes="eyebrow" />
            <WrapPanel>

              <!-- Logos reales (simple-icons): Avalonia UI y .NET tienen
                   marca publicada y libre de usar. -->
              <Border Classes="techchip" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Viewbox Width="14" Height="14">
                    <Canvas Width="24" Height="24">
                      <Path Fill="#165BFF" Data="M12.034 8.208c-2.003 0-3.627 1.696-3.627 3.789s1.624 3.789 3.627 3.789 3.627-1.697 3.627-3.79-1.624-3.788-3.627-3.788m-7.392 2.067c.72.211 1.248.902 1.248 1.722s-.528 1.51-1.248 1.721c.752 3.54 3.776 6.188 7.392 6.188 1.316 0 2.554-.35 3.632-.967v.914h3.94v-7.528a5 5 0 0 0 0-.224v-.104c0-4.369-3.39-7.91-7.572-7.91-3.616 0-6.64 2.648-7.392 6.188m-.5 2.982c.67 0 1.212-.567 1.212-1.266s-.542-1.265-1.212-1.265-1.211.566-1.211 1.265c0 .7.542 1.266 1.211 1.266M20.682 24H11.8C5.549 23.887.515 18.556.515 12c0-6.627 5.143-12 11.487-12 6.241 0 11.32 5.2 11.483 11.678l-.02 9.743C23.3 22.876 22.12 24 20.683 24" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="Avalonia UI" />
                </StackPanel>
              </Border>

              <Border Classes="techchip" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Viewbox Width="14" Height="14">
                    <Canvas Width="24" Height="24">
                      <Path Fill="#512BD4" Data="M24 8.77h-2.468v7.565h-1.425V8.77h-2.462V7.53H24zm-6.852 7.565h-4.821V7.53h4.63v1.24h-3.205v2.494h2.953v1.234h-2.953v2.604h3.396zm-6.708 0H8.882L4.78 9.863a2.896 2.896 0 0 1-.258-.51h-.036c.032.189.048.592.048 1.21v5.772H3.157V7.53h1.659l3.965 6.32c.167.261.275.442.323.54h.024c-.04-.233-.06-.629-.06-1.185V7.529h1.372zm-8.703-.693a.868.829 0 0 1-.869.829.868.829 0 0 1-.868-.83.868.829 0 0 1 .868-.828.868.829 0 0 1 .869.829Z" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text=".NET 10" />
                </StackPanel>
              </Border>

              <Border Classes="techchip" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Viewbox Width="14" Height="14">
                    <Canvas Width="24" Height="24">
                      <Path Fill="#005CED" Data="M23.0325 11.2963c-.0503 0-.1006 0-.1508.0126l-4.021-7.4387c.0754-.1383.1131-.289.1131-.4524 0-.5403-.4398-.9675-.9675-.9675-.2765 0-.5278.113-.7037.3015L9.286 1.156C9.2357.6785 8.821.3016 8.3184.3016c-.5277 0-.9675.4398-.9675.9675 0 .1634.0377.3141.113.4524l-6.245 8.9591c-.0753-.0251-.1633-.0377-.2513-.0377-.5403 0-.9675.4398-.9675.9676 0 .5403.4398.9675.9675.9675h.0377l3.3676 8.3309c-.0503.1257-.088.2639-.088.402 0 .5404.4398.9676.9676.9676.2764 0 .5277-.113.7036-.3015l10.1152.9926c.1005.4273.49.7288.9424.7288.5403 0 .9676-.4398.9676-.9675 0-.2388-.088-.465-.2262-.6283l5.1141-8.8712c.0503.0126.1005.0126.1634.0126.5403 0 .9675-.4398.9675-.9676 0-.5403-.4272-.98-.9675-.98zM17.2272 4.021c.1131.1508.2765.264.4524.3267l-1.533 11.5728c-.1005.0252-.1885.0503-.2764.1005L7.4513 8.708c.0251-.0754.0377-.1634.0377-.2514 0-.0628-.0126-.1256-.0126-.1884zm4.8754 8.5068l-5.177 3.556a1.105 1.105 0 0 0-.1256-.0753L18.3455 4.335h.0126l3.9456 7.288c-.1508.1759-.2388.3895-.2388.6408 0 .1005.0126.1885.0377.2638zM6.3832 7.5016c-.4649.0754-.8293.4775-.8293.955v.0628l-3.4555 2.0481 5.378-7.7026zm.3519 1.91c.1256-.0252.2513-.088.3518-.1634l8.356 7.2628c-.0377.113-.0628.2262-.0628.3518v.0503l-9.311 3.845c-.1382-.201-.3518-.3518-.6031-.402zm8.8963 8.1172c.1257.1382.3016.2513.5026.289l.465 4.046c-.201.1006-.3519.264-.4524.4524l-9.8136-.955zm1.1435.2136c.3267-.1633.5403-.49.5403-.867 0-.088-.0126-.1634-.0377-.2513l4.7372-3.2545-4.8 8.331zm.2513-14.3497l-9.889 4.31-.1131-.0755 1.2565-5.3906h.0377c.3393 0 .6409-.1759.8168-.4397l7.891 1.5706zM1.935 11.6105c0-.0629-.0126-.1257-.0126-.1885l3.9079-2.2995c.0754.0754.1633.1508.2638.201L4.8252 20.243l-3.2043-7.9036c.1885-.176.3142-.4398.3142-.7288Z" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="ONNX Runtime" />
                </StackPanel>
              </Border>

              <!-- Sin logo de marca libre disponible para estas: se marcan
                   con un glifo neutro en vez de inventar uno. -->
              <Border Classes="techchip" Margin="0,0,8,8">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="{}{ }" Foreground="{DynamicResource FraguaTextMutedBrush}" FontFamily="{DynamicResource FontMono}" />
                  <TextBlock Text="C#" />
                </StackPanel>
              </Border>
              <Border Classes="techchip" Margin="0,0,8,8"><TextBlock Text="Magick.NET" /></Border>
              <Border Classes="techchip" Margin="0,0,8,8"><TextBlock Text="CommunityToolkit.Mvvm" /></Border>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="20">
          <StackPanel Spacing="6">
            <TextBlock Text="Licencia" Classes="eyebrow" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="MIT. Mona Sans y Commit Mono, SIL Open Font License. Magick.NET, Apache 2.0." />
          </StackPanel>
        </Border>
      </StackPanel>

     </Grid>
    </ScrollViewer>
  </Grid>

</Window>
